  },
  "license": "MIT",
  "scripts": {
    "build": "npm run build:main && npm run build:walk && npm run build:loose && npm run build:using",
    "build:loose": "rollup -c acorn-loose/rollup.config.mjs",
    "build:main": "rollup -c acorn/rollup.config.mjs",
    "build:using": "rollup -c acorn-using/rollup.config.mjs",
    "build:walk": "rollup -c acorn-walk/rollup.config.mjs",
    "generate": "node bin/generate-identifier-regex.js",
    "lint": "eslint .",
    "prepare": "npm run test",
    "pretest": "npm run build:main && npm run build:loose && npm run build:using",
    "test": "node test/run.js && npm run lint"
  },
  "devDependencies": {
    "@rollup/plugin-buble": "^1.0.2",
    "@unicode/unicode-15.0.0": "^1.3.1",
    "eslint": "^8.42.0",
    "eslint-config-standard": "^17.1.0",
    "eslint-plugin-import": "^2.27.5",
    "eslint-plugin-node": "^11.1.0",
    "eslint-plugin-promise": "^6.1.1",
    "rollup": "^3.25.1"
  }
}
